# Backend environment variables (do not put secrets in source control)

# Required: secret used to sign JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Optional JWT settings
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_TTL_SECONDS="604800"

# CORS allowed origins (comma-separated). If unset, backend allows all origins (preview-friendly).
# Example:
# CORS_ALLOW_ORIGINS="http://localhost:3000,https://<preview-frontend-host>"
CORS_ALLOW_ORIGINS=""

# Optional DB fallback (preferred is db_connection.txt in working dir/container root or sibling notes_database/)
# DATABASE_URL="postgresql://appuser:dbuser123@localhost:5000/myapp"
